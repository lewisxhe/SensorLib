PROJECT_NAME           = "SensorLib"
PROJECT_BRIEF          = "Multi-platform sensor driver library for Arduino, PlatformIO, and ESP-IDF"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INPUT                   = README.md src examples
FILE_PATTERNS           = *.c \
                          *.cc \
                          *.cpp \
                          *.cxx \
                          *.h \
                          *.hh \
                          *.hpp \
                          *.hxx \
                          *.ino \
                          *.md
RECURSIVE               = YES
EXCLUDE                 = src/bosch
EXTENSION_MAPPING       = ino=C++
USE_MDFILE_AS_MAINPAGE  = README.md

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR            = YES
DISABLE_INDEX           = NO
GENERATE_LATEX          = NO

HAVE_DOT                = YES
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
COLLABORATION_GRAPH     = NO
INCLUDE_GRAPH           = YES
INCLUDED_BY_GRAPH       = YES
CALL_GRAPH              = NO
CALLER_GRAPH            = NO
DIRECTORY_GRAPH         = YES
